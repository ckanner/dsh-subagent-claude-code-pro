{
  "name": "dsh-subagent-claude-code-pro",
  "version": "0.5.0",
  "description": "DeepSeek Harness plugin: Claude Code delegation using your local CLI — per-call model and effort, durable sessions, and multimodal input/output.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./machine": {
      "types": "./lib/machine.d.ts",
      "import": "./lib/machine.js"
    },
    "./package.json": "./package.json",
    "./client": "./assets/client.js"
  },
  "files": [
    "lib",
    "scripts",
    "docs",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "icon.svg",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "test": "node --test \"tests/*.spec.mjs\"",
    "test:package": "node scripts/verify-machine-package.mjs",
    "probe": "node scripts/probe-live.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:host": "node scripts/verify-dsh-contract.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "claude-code",
    "claude",
    "subagent",
    "delegation"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ckanner/dsh-subagent-claude-code-pro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckanner/dsh-subagent-claude-code-pro.git"
  },
  "bugs": {
    "url": "https://github.com/ckanner/dsh-subagent-claude-code-pro/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "icon": "./icon.svg",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "@deepseek-ai/dsh-home-paths": "^0.2.2-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.3",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-executor-ptc": "0.2.2-rc.3"
  }
}
